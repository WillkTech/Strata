#!/bin/sh
# llm — alias for the Strata monitor (the in-monitor Model Switcher dialog)
# Resolves Strata repository and opens the monitor using the dedicated virtual environment.

set -eu

# Resolve script directory (following symlinks)
self=$0
while [ -L "$self" ]; do
  dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd -P)
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$dir/$target ;;
  esac
done
BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd -P)
ROOT=$(CDPATH= cd -- "$BIN_DIR/.." && pwd -P)

# Preferred python in /Volumes/vl/ai/.venv/bin/python, fallback to local .venv or python3
if [ -x "/Volumes/vl/ai/.venv/bin/python" ]; then
  PY="/Volumes/vl/ai/.venv/bin/python"
elif [ -x "$ROOT/.venv/bin/python" ]; then
  PY="$ROOT/.venv/bin/python"
elif [ -x "$ROOT/python/bin/python3" ]; then
  PY="$ROOT/python/bin/python3"
else
  PY="python3"
fi

export PYTHONPATH="$ROOT:${PYTHONPATH:-}"
cd "$ROOT"

exec "$PY" "$ROOT/strata.py" monitor "$@"
